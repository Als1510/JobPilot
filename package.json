{
  "name": "JobPilot",
  "version": "0.1.0",
  "private": true,
  "description": "JobPilot - AI job search & application assistant (M1: Job Intelligence)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run web",
    "dev": "npm run dev -w @JobPilot/web",
    "web": "npm run start -w @JobPilot/web",
    "cli": "tsx apps/cli/src/index.ts",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:deploy-migrations": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/src/seed.ts",
    "setup": "npm install && npm run db:generate && npm run db:migrate && npm run db:seed",
    "postinstall": "npm run db:generate"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}