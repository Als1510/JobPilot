{
  "name": "jobpilot",
  "version": "0.1.0",
  "private": true,
  "description": "JobPilot - AI job search & application assistant (M1: Job Intelligence)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "cli": "tsx apps/cli/src/index.ts",
    "db:generate": "npm run db:generate -w @jobpilot/db",
    "db:migrate": "npm run db:migrate -w @jobpilot/db",
    "db:seed": "npm run db:seed -w @jobpilot/db",
    "setup": "npm install && npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}