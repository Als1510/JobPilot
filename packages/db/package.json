{
  "name": "@JobPilot/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
    "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@JobPilot/core": "*",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2"
  }
}