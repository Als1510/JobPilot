# JobPilot environment configuration
# Copy to .env and fill in values. NEVER commit .env

# ---------------------------------------------------------------------------
# Database (M1 uses SQLite; M3 will switch to PostgreSQL/Supabase)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# LLM Provider
# JobPilot supports any OpenAI-compatible endpoint.
#   "OpenRouter", "GenericOpenAI" (e.g. DeepSeek, NVIDIA, local servers), "Fake"
# The Fake provider is deterministic and needs no API key (offline/testing).
# ---------------------------------------------------------------------------
LLM_PROVIDER="Fake"
LLM_API_BASE="https://openrouter.ai/api/v1"
LLM_API_KEY=""
LLM_MODEL="openai/gpt-4o-mini"

# Optional headers for OpenRouter-style auth (X-Title etc.) - add as needed
# LLM_EXTRA_HEADERS='{"HTTP-Referer":"http://localhost:3000","X-Title":"JobPilot"}'

# ---------------------------------------------------------------------------
# Job Sources
# M1 ships with the Mock source (offline, exercises dedup across boards).
# Greenhouse: requires a board token (e.g. a company's public Greenhouse
# board: https://boards.greenhouse.io/<board-token>)
# ---------------------------------------------------------------------------
GREENHOUSE_BOARD_TOKEN=""

# ---------------------------------------------------------------------------
# Jobvetta (live India jobs API) - requires a free API key from
# https://www.jobvetta.com/dashboard . Docs: https://jobvetta.com/api
# ---------------------------------------------------------------------------
JOBVETTA_API_KEY=""
JOBVETTA_BASE_URL="https://api.jobvetta.com/v1"

# Scores: how strong must a match be to count as "strong" (0-100)?
MATCH_STRONG_THRESHOLD="60"